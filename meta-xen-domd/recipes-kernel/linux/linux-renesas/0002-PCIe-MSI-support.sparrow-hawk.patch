diff --git a/drivers/pci/controller/dwc/pcie-rcar-gen4.c b/drivers/pci/controller/dwc/pcie-rcar-gen4.c
index 397c2f947..ccf3e65fe 100644
--- a/drivers/pci/controller/dwc/pcie-rcar-gen4.c
+++ b/drivers/pci/controller/dwc/pcie-rcar-gen4.c
@@ -37,6 +37,12 @@
 /* PCIe Interrupt Status 0 Enable */
 #define PCIEINTSTS0EN		0x0310
 #define MSI_CTRL_INT		BIT(26)
+
+/* AXI Interrupt Controller for MSI (Sparrow Hawk specific) */
+#define AXIINTCADDR		0x0a00
+#define AXIINTCADDR_VAL		0xf1050040
+#define AXIINTCCONT		0x0a04
+#define AXIINTCCONT_VAL		(BIT(31) | GENMASK(11, 2))
 #define SMLH_LINK_UP		BIT(7)
 #define RDLH_LINK_UP		BIT(6)
 
@@ -333,6 +339,10 @@ static int rcar_gen4_pcie_host_init(struct dw_pcie_rp *pp)
 	val |= MSI_CTRL_INT;
 	writel(val, rcar->base + PCIEINTSTS0EN);
 
+	/* Configure AXI interrupt controller for MSI (Sparrow Hawk specific) */
+	writel(AXIINTCADDR_VAL, rcar->base + AXIINTCADDR);
+	writel(AXIINTCCONT_VAL, rcar->base + AXIINTCCONT);
+
 	msleep(PCIE_T_PVPERL_MS);	/* pe_rst requires 100msec delay */
 
 	gpiod_set_value_cansleep(dw->pe_rst, 0);
